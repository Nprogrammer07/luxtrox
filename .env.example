# Copia este archivo a ".env" (ya esta en .gitignore) y pon los
# valores reales ahi -- nunca en docker-compose.yml ni en este archivo.

# Si la dejas vacia, docker-compose usa "luxtrox" por defecto (ver
# docker-compose.yml) -- solo importa si quieres una password distinta
# para el Postgres LOCAL que levanta este mismo docker-compose.
DB_PASSWORD=

# Obligatoria. Cualquier string aleatorio de 32+ caracteres para
# desarrollo local -- en produccion debe ser otro, secreto, y nunca el
# mismo que uses aqui (ver docs/running-locally.md).
JWT_SECRET=

# Opcional -- por defecto http://localhost:3000 (ver docker-compose.yml).
CORS_ALLOWED_ORIGINS=

# Opcionales -- si las dejas vacias, el backend arranca igual (Fase 9:
# /actuator/health va a mostrar esas integraciones especificas como
# DOWN, sin tumbar el resto de la app).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_IPN_CALLBACK_URL=
RESEND_API_KEY=
SUPABASE_STORAGE_ENDPOINT=
SUPABASE_STORAGE_REGION=
SUPABASE_STORAGE_ACCESS_KEY_ID=
SUPABASE_STORAGE_SECRET_ACCESS_KEY=
