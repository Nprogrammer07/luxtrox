<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.luxtrox</groupId>
    <artifactId>luxtrox-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>LUXTROX ALGORITMO - Backend</name>

    <properties>
        <java.version>21</java.version>
        <flyway.version>10.20.1</flyway.version>
        <springdoc.version>2.6.0</springdoc.version>
        <testcontainers.version>1.21.4</testcontainers.version>
        <jjwt.version>0.12.6</jjwt.version>
        <aws-sdk.version>2.28.29</aws-sdk.version>
        <openpdf.version>1.3.43</openpdf.version>
        <!--
            Fase 8: spring-boot-starter-parent 3.3.5 trae una version de
            Mockito (con Byte Buddy viejo) que no soporta Java 25: "no
            es supported by the current version of Byte Buddy which
            officially supports Java 23/24". Mockito expone esta
            propiedad especificamente para sobreescribirla sin tocar
            ninguna otra dependencia (asi lo documenta Spring Boot).
        -->
        <mockito.version>5.22.0</mockito.version>
    </properties>

    <!--
        Fase 3 trajo Flyway (migraciones). Fase 4 (Spring Boot Core)
        AGREGA aqui mismo web/data-jpa/validation/actuator/openapi,
        nada de lo de Fase 3 se quito.
    -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring Boot Core -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
            Fase 9: metricas. Sin version explicita: Spring Boot
            gestiona la version compatible de Micrometer via su propio
            BOM, igual que con el resto de starters. Expone
            /actuator/prometheus, listo para que un Prometheus se
            conecte despues aunque todavia no haya uno corriendo.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!--
            Fase 9: logs estructurados en JSON. 8.0 a proposito, NO
            9.0: esa version migro a Jackson 3, que no es lo que trae
            Spring Boot 3.3.5 (Jackson 2.x). 8.0 es la ultima que
            sigue siendo Jackson 2 (recomienda 2.17.x, que es
            practicamente lo que Spring Boot ya trae).
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>8.0</version>
        </dependency>

        <!-- OpenAPI / Swagger -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Security (Fase 5) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Base de datos -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway (heredado de Fase 3) -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            Fase 8: tests de API de punta a punta (HTTP real y
            seguridad, no solo el service layer). 5.5.7, NO 6.0.0:
            esa version sube la base a Spring 7 / Jackson 3, que no
            es lo que trae Spring Boot 3.3.5 (Spring 6 / Jackson 2).
        -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>5.5.7</version>
            <scope>test</scope>
        </dependency>

        <!-- Integraciones externas (Fase 7) -->
        <!-- Cliente S3, usado contra Supabase Storage (S3-compatible),
             no AWS real. NOWPayments y Resend usan RestClient (incluido
             en Spring Web), no necesitan SDK propio. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws-sdk.version}</version>
        </dependency>
        <!-- Generacion de PDF de facturas. OpenPDF (LGPL/MPL, gratuita)
             en vez de iText 7+ (AGPL/comercial). -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>${openpdf.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
                Fase 8: tu JDK 25 (Eclipse Adoptium 25.0.3) es lo
                bastante nuevo como para que el detector de version de
                Byte Buddy (la libreria que usa Mockito para crear
                mocks) no lo reconozca bien todavia, incluso con
                Mockito ya actualizado, el propio mensaje de error de
                Mockito sugiere exactamente este flag como solucion.
                "@{argLine}" (no "${argLine}") es la sintaxis que
                referencia lo que JaCoCo ya puso ahi abajo, para que
                los dos agentes (JaCoCo + el flag de Byte Buddy)
                convivan en la misma corrida de tests sin que uno
                pise al otro.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Dnet.bytebuddy.experimental=true</argLine>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <version>${flyway.version}</version>
                <!--
                    Credenciales NUNCA en este archivo. Viven en
                    flyway.conf (gitignored). Ver docs/supabase-setup.md
                -->
                <configuration>
                    <locations>
                        <location>filesystem:src/main/resources/db/migration</location>
                    </locations>
                    <configFiles>
                        <configFile>flyway.conf</configFile>
                    </configFiles>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>org.postgresql</groupId>
                        <artifactId>postgresql</artifactId>
                        <version>42.7.4</version>
                    </dependency>
                </dependencies>
            </plugin>

            <!--
                Fase 8: cobertura de tests. "prepare-agent" instrumenta
                el codigo antes de correr los tests; "report" genera el
                HTML en target/site/jacoco/index.html con TODO (sin
                exclusiones, para tener visibilidad completa); "check"
                es el gate duro del 90% del prompt maestro, pero
                aplicado solo a paquetes de LOGICA real (service,
                controller, security, exception, integration.*):
                entity y dto.* quedan fuera del gate a proposito: son
                en su mayoria getters/setters/records sin logica
                propia, donde perseguir 90% de cobertura de lineas no
                reduce ningun riesgo real, solo "infla" el numero.
                Siguen midiendose y apareciendo en el reporte HTML,
                solo no hacen fallar el build.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.12</version>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>check</id>
                        <phase>test</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <excludes>
                                <exclude>**/entity/**</exclude>
                                <exclude>**/dto/**</exclude>
                                <exclude>**/LuxtroxBackendApplication.class</exclude>
                            </excludes>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>INSTRUCTION</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>